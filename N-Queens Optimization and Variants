import java.util.*;

public class Main {

    static int N = 8;

    static int[] board = new int[N];        // board[row] = column
    static boolean[] col = new boolean[N];  
    static boolean[] diag1 = new boolean[2*N-1];
    static boolean[] diag2 = new boolean[2*N-1];

    static boolean solve(int row) {

        // goal condition
        if(row == N)
            return true;

        for(int c = 0; c < N; c++) {

            int d1 = row - c + (N - 1);
            int d2 = row + c;

            if(!col[c] && !diag1[d1] && !diag2[d2]) {

                board[row] = c;

                col[c] = true;
                diag1[d1] = true;
                diag2[d2] = true;

                if(solve(row + 1))
                    return true;

                // backtrack
                col[c] = false;
                diag1[d1] = false;
                diag2[d2] = false;
            }
        }

        return false;
    }

    static void printBoard() {

        for(int i = 0; i < N; i++) {
            for(int j = 0; j < N; j++) {

                if(board[i] == j)
                    System.out.print("Q ");
                else
                    System.out.print(". ");
            }
            System.out.println();
        }
    }

    public static void main(String[] args) {

        if(solve(0)) {
            System.out.println("One Valid Solution:");
            printBoard();
        } else {
            System.out.println("No solution exists.");
        }
    }
}
